# start.gg の開発者設定で発行したトークン(サーバー側でのみ使用。NEXT_PUBLIC_ を付けないこと)
STARTGG_TOKEN=

# 大会ロゴの扱い: all = 全大会でロゴを使う / allowlist = src/config.ts の LOGO_ALLOWLIST の大会だけ
LOGO_MODE=all

# start.gg でのログイン(マイバインダーの本人確認)。https://start.gg/admin/profile/developer/applications でアプリを作成して取得する
# リダイレクト先に <サイトのURL>/api/auth/callback を登録すること(ローカルは http://localhost:3000/api/auth/callback)
STARTGG_OAUTH_CLIENT_ID=
STARTGG_OAUTH_CLIENT_SECRET=
# ログイン状態の署名に使う秘密の文字列。openssl rand -base64 32 で作る
SESSION_SECRET=
